#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
command -v uv >/dev/null || { echo "uv missing; see https://docs.astral.sh/uv" >&2; exit 1; }
command -v jq >/dev/null || { echo "jq missing" >&2; exit 1; }
setup=$(jq -r '.setup // empty' .unslop/adopt.json)
[ -z "$setup" ] || bash -c "$setup"
