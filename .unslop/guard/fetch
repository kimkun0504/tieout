#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
  detekt)
    url=https://github.com/detekt/detekt/releases/download/v1.23.8/detekt-cli-1.23.8-all.jar
    sum=2ce2ff952e150baf28a29cda70a363b0340b3e81a55f43e51ec5edffc3d066c1
    name=detekt-cli.jar ;;
  pmd)
    url=https://github.com/pmd/pmd/releases/download/pmd_releases%2F7.29.0/pmd-dist-7.29.0-bin.zip
    sum=d27177c185b837fa57f097e482d1253468aa035379c5eb2671fa0a279109b179
    name=pmd.zip ;;
  phpstan)
    url=https://github.com/phpstan/phpstan/releases/download/2.3.6/phpstan.phar
    sum=bd5af896c8eb831e10873a4407c37ac33118dcd88de4ea77e13cd6e6702a41cc
    name=phpstan.phar ;;
  swiftlint)
    base=https://github.com/realm/SwiftLint/releases/download/0.65.1
    case "$(uname -s)-$(uname -m)" in
      Linux-x86_64) url=$base/swiftlint_linux_amd64.zip sum=caeed6f4a679c35539ffaf124f6c4ab4a8416917f7d8796279dc52b74026059d ;;
      Linux-aarch64 | Linux-arm64) url=$base/swiftlint_linux_arm64.zip sum=9ffa52f478e6d8eb485d37d14715ffac90abc81c58f3370d598bf75be05605f8 ;;
      Darwin-*) url=$base/portable_swiftlint.zip sum=c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0 ;;
      *) echo "fetch: no SwiftLint build for $(uname -s)-$(uname -m)" >&2; exit 1 ;;
    esac
    name=swiftlint.zip ;;
  *) echo "usage: fetch detekt|pmd|phpstan|swiftlint" >&2; exit 2 ;;
esac
dir="${XDG_CACHE_HOME:-$HOME/.cache}/unslop/$sum"
if [ ! -f "$dir/$name" ]; then
  mkdir -p "$dir"
  curl -fsSL --retry 3 -o "$dir/$name.part" "$url"
  echo "$sum  $dir/$name.part" | sha256sum -c --quiet - >&2 || { rm -f "$dir/$name.part"; echo "fetch: checksum mismatch for $url" >&2; exit 1; }
  mv "$dir/$name.part" "$dir/$name"
fi
unpack() {
  [ -d "$dir/unpacked" ] && return 0
  uv run --quiet --no-project --python 3.13 python -c 'import sys, zipfile; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])' "$dir/$name" "$dir/unpacked.part"
  find "$dir/unpacked.part" -type f \( -name pmd -o -name swiftlint \) -exec chmod +x {} +
  mv "$dir/unpacked.part" "$dir/unpacked"
}
if [ "$name" = pmd.zip ]; then
  unpack
  echo "$dir/unpacked/pmd-bin-7.29.0/bin/pmd"
elif [ "$name" = swiftlint.zip ]; then
  unpack
  echo "$dir/unpacked/swiftlint"
else
  echo "$dir/$name"
fi
